# URL pública do site, sem barra no fim. Usada nas meta tags (og:image).
# URL definitiva do deploy. Pode ser sobrescrita por variável de build (VITE_SITE_URL na Vercel).
VITE_SITE_URL=https://indicadores-br.vercel.app
# Token do Cloudflare Web Analytics (opcional). Vazio = sem analytics.
VITE_CF_BEACON_TOKEN=
